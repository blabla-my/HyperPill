         ret = kvm_xen_handle_exit(cpu, &run->xen);
         break;
 #endif
+    case KVM_EXIT_HYPERCALL:
+        printf("=== HYPERPILL HYPERCALL RECEIVED ===\n");
+        kvm_arch_get_registers(cs);
+        vm_stop(RUN_STATE_PAUSED);
