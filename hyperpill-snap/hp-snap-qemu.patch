diff --git a/target/i386/cpu-dump.c b/target/i386/cpu-dump.c
index 40697064d..4450321f0 100644
--- a/target/i386/cpu-dump.c
+++ b/target/i386/cpu-dump.c
@@ -99,9 +99,9 @@ cpu_x86_dump_seg_cache(CPUX86State *env, FILE *f,
 {
 #ifdef TARGET_X86_64
     if (env->hflags & HF_CS64_MASK) {
-        qemu_fprintf(f, "%-3s=%04x %016" PRIx64 " %08x %08x", name,
+        qemu_fprintf(f, "%-3s=%04x %016" PRIx64 " %08x %x", name,
                      sc->selector, sc->base, sc->limit,
-                     sc->flags & 0x00ffff00);
+                     sc->flags);
     } else
 #endif
     {
@@ -221,6 +221,51 @@ static inline void mask2str(char *str, uint32_t val, uint8_t size)
 
 #define MAX_LOGICAL_APIC_ID_MASK_SIZE 16
 
+static void dump_apic_registers(APICCommonState *s)
+{
+    int i;
+
+    qemu_printf("APIC_REGS_BEGIN\n");
+    qemu_printf("APIC_REG 0x020 0x%08x\n", s->id << 24);
+    qemu_printf("APIC_REG 0x030 0x%08x\n",
+                s->version | ((APIC_LVT_NB - 1) << 16));
+    qemu_printf("APIC_REG 0x080 0x%08x\n", s->tpr);
+    qemu_printf("APIC_REG 0x090 0x%08x\n", 0);
+    qemu_printf("APIC_REG 0x0A0 0x%08x\n", apic_get_ppr(s));
+    qemu_printf("APIC_REG 0x0B0 0x%08x\n", 0);
+    qemu_printf("APIC_REG 0x0D0 0x%08x\n", s->log_dest << 24);
+    qemu_printf("APIC_REG 0x0E0 0x%08x\n",
+                (s->dest_mode << 28) | 0x0fffffff);
+    qemu_printf("APIC_REG 0x0F0 0x%08x\n", s->spurious_vec);
+
+    for (i = 0; i < 8; i++) {
+        qemu_printf("APIC_REG 0x%03x 0x%08x\n",
+                    0x100 + i * 0x10, s->isr[i]);
+    }
+    for (i = 0; i < 8; i++) {
+        qemu_printf("APIC_REG 0x%03x 0x%08x\n",
+                    0x180 + i * 0x10, s->tmr[i]);
+    }
+    for (i = 0; i < 8; i++) {
+        qemu_printf("APIC_REG 0x%03x 0x%08x\n",
+                    0x200 + i * 0x10, s->irr[i]);
+    }
+
+    qemu_printf("APIC_REG 0x280 0x%08x\n", s->esr);
+    qemu_printf("APIC_REG 0x300 0x%08x\n", s->icr[0]);
+    qemu_printf("APIC_REG 0x310 0x%08x\n", s->icr[1]);
+
+    for (i = 0; i < APIC_LVT_NB; i++) {
+        qemu_printf("APIC_REG 0x%03x 0x%08x\n",
+                    0x320 + i * 0x10, s->lvt[i]);
+    }
+
+    qemu_printf("APIC_REG 0x380 0x%08x\n", s->initial_count);
+    qemu_printf("APIC_REG 0x390 0x%08x\n", apic_get_current_count(s));
+    qemu_printf("APIC_REG 0x3E0 0x%08x\n", s->divide_conf);
+    qemu_printf("APIC_REGS_END\n");
+}
+
 static void dump_apic_icr(APICCommonState *s, CPUX86State *env)
 {
     uint32_t icr = s->icr[0], icr2 = s->icr[1];
@@ -300,6 +345,7 @@ void x86_cpu_dump_local_apic_state(CPUState *cs, int flags)
 
     qemu_printf("dumping local APIC state for CPU %-2u\n\n",
                 CPU(cpu)->cpu_index);
+    dump_apic_registers(s);
     dump_apic_lvt("LVT0", lvt[APIC_LVT_LINT0], false);
     dump_apic_lvt("LVT1", lvt[APIC_LVT_LINT1], false);
     dump_apic_lvt("LVTPC", lvt[APIC_LVT_PERFORM], false);
@@ -421,6 +467,36 @@ void x86_cpu_dump_state(CPUState *cs, FILE *f, int flags)
     cpu_x86_dump_seg_cache(env, f, "LDT", &env->ldt);
     cpu_x86_dump_seg_cache(env, f, "TR", &env->tr);
 
+#define dumpmsr(name) \
+    qemu_fprintf(f, #name " = %lx\n", env-> name );
+#define dumpmsr32(name) \
+    qemu_fprintf(f, #name " = %x\n", env-> name );
+
+    dumpmsr(kernelgsbase);
+    dumpmsr(lstar);
+    dumpmsr(cstar);
+    dumpmsr(fmask);
+
+    dumpmsr32(sysenter_cs);
+    dumpmsr(sysenter_esp);
+    dumpmsr(sysenter_eip);
+    dumpmsr(star);
+
+    dumpmsr(tsc);
+    dumpmsr(tsc_adjust);
+    dumpmsr(tsc_khz);
+    dumpmsr(tsc_deadline);
+    dumpmsr(tsc_aux);
+
+
+    dumpmsr(pat);
+    dumpmsr(xcr0);
+
+
+    uint64_t val = cpu_get_apic_base(env_archcpu(env)->apic_state);
+    qemu_fprintf(f, "apicbase =     %lx\n", val );
+
+
 #ifdef TARGET_X86_64
     if (env->hflags & HF_LMA_MASK) {
         qemu_fprintf(f, "GDT=     %016" PRIx64 " %08x\n",
@@ -501,6 +577,11 @@ void x86_cpu_dump_state(CPUState *cs, FILE *f, int flags)
             else
                 qemu_fprintf(f, " ");
         }
+        qemu_fprintf(f,
+                     "FPUIP=%016" PRIx64 " FPUDP=%016" PRIx64
+                     " FPUCS=%04x FPUDS=%04x FPUOP=%04x\n",
+                     env->fpip, env->fpdp, env->fpcs, env->fpds,
+                     env->fpop);
 
         if ((env->xcr0 & avx512_mask) == avx512_mask) {
             /* XSAVE enabled AVX512 */
@@ -564,4 +645,8 @@ void x86_cpu_dump_state(CPUState *cs, FILE *f, int flags)
         }
         qemu_fprintf(f, "\n");
     }
+
+    if (!f) {
+        x86_cpu_dump_local_apic_state(cs, flags);
+    }
 }
diff --git a/target/i386/kvm/kvm.c b/target/i386/kvm/kvm.c
